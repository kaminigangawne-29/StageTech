// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Core User
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("TECHNICIAN") // TECHNICIAN | PRODUCTION | ADMIN
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  technicianProfile  TechnicianProfile?
  productionCompany  ProductionCompany?
  sentMessages       Message[]          @relation("SentMessages")
  receivedMessages   Message[]          @relation("ReceivedMessages")
}

// ─────────────────────────────────────────────
// Technician
// ─────────────────────────────────────────────

model TechnicianProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  fullName             String
  bio                  String?
  locationCity         String?
  primaryDiscipline    String?  // LIGHTING_DESIGNER | SOUND_DESIGNER | etc.
  secondaryDisciplines String?  // JSON array stored as string, e.g. '["SOUND_OPERATOR","SET_DESIGNER"]'
  availabilityStatus   String   @default("AVAILABLE") // AVAILABLE | BOOKED | OPEN_TO_OFFERS
  profileImageUrl      String?
  linkedinUrl          String?
  websiteUrl           String?
  phone                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            TechnicianSkill[]
  portfolioItems    PortfolioItem[]
  productionHistory ProductionHistory[]
  jobApplications   JobApplication[]
  savedByCompanies  SavedTechnician[]
}

model Skill {
  id          String            @id @default(cuid())
  name        String            @unique

  // Relations
  technicians TechnicianSkill[]
}

model TechnicianSkill {
  technicianId String
  skillId      String

  @@id([technicianId, skillId])

  // Relations
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id           String   @id @default(cuid())
  technicianId String
  title        String
  description  String?
  mediaUrl     String
  mediaType    String   @default("IMAGE") // IMAGE | VIDEO | LINK | PDF
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

model ProductionHistory {
  id           String    @id @default(cuid())
  technicianId String
  showTitle    String
  company      String?
  roleHeld     String
  startDate    DateTime?
  endDate      DateTime?
  description  String?

  // Relations
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Production Company
// ─────────────────────────────────────────────

model ProductionCompany {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  description String?
  website     String?
  logoUrl     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostings      JobPosting[]
  savedTechnicians SavedTechnician[]
}

// ─────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────

model JobPosting {
  id             String    @id @default(cuid())
  companyId      String
  title          String
  description    String
  roleNeeded     String
  startDate      DateTime?
  endDate        DateTime?
  budget         String?
  location       String?
  skillsRequired String?   // JSON array stored as string
  status         String    @default("OPEN") // OPEN | FILLED | CLOSED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  company      ProductionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  messages     Message[]
}

model JobApplication {
  id           String   @id @default(cuid())
  jobId        String
  technicianId String
  coverLetter  String?
  status       String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt    DateTime @default(now())

  // Relations
  job        JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([jobId, technicianId])
}

// ─────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────

model Message {
  id           String   @id @default(cuid())
  senderId     String
  receiverId   String
  content      String
  sentAt       DateTime @default(now())
  isRead       Boolean  @default(false)
  jobPostingId String?

  // Relations
  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────
// Saved / Favourites
// ─────────────────────────────────────────────

model SavedTechnician {
  id           String   @id @default(cuid())
  companyId    String
  technicianId String
  listName     String   @default("Saved")
  savedAt      DateTime @default(now())

  // Relations
  company    ProductionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([companyId, technicianId])
}
